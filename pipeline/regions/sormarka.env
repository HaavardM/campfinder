# Sørmarka, the forest south-east of Oslo between Oslo, Nordre Follo and
# Enebakk. No official boundary, so a box around Sværsvann in its middle
# (270 km E, 6638 km N), reaching south of the Østmarka box, which already
# covers its northern half. EPSG:25833 metres, on the 2 km tile grid
# (100 tiles).
WEST=258000
SOUTH=6620000
EAST=278000
NORTH=6640000
# N50 county files covering the box (Kartverket names), for the no-go areas.
N50_COUNTIES="32_Akershus 03_Oslo 31_Ostfold"
