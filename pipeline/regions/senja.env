# Senja: the island's wild outer coast (Senjahopen, Gryllefjord) and
# Ånderdalen national park, to Finnsnes on the inner side. Much of it is
# sea, which the N50 sea map lets the engine skip. A box around
# Kartverket's place names. EPSG:25833 metres, on the 2 km tile grid (1050
# tiles).
WEST=562000
SOUTH=7658000
EAST=622000
NORTH=7728000
# N50 county files covering the box (Kartverket names), for the no-go areas.
N50_COUNTIES="55_Troms"
