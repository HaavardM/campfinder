# Helgelandskysten, the islands and coast from Torghatten and Vega to Sju
# søstre, Dønna, Lovund and Træna. No official boundary, so a box around
# those places (Kartverket's place names). Mostly sea: Kartverket sends
# those tiles empty, so they cost next to nothing. EPSG:25833 metres, on the
# 2 km tile grid (2010 tiles).
WEST=344000
SOUTH=7250000
EAST=404000
NORTH=7384000
# N50 county files covering the box (Kartverket names), for the no-go areas.
N50_COUNTIES="18_Nordland"
