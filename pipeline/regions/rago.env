# Rago national park: its official extent (Miljødirektoratet's
# protected-area register), on the Swedish border east of Sulitjelma. The
# Swedish side has no surface data and no N50: no spots there. EPSG:25833
# metres, on the 2 km tile grid (100 tiles).
WEST=532000
SOUTH=7472000
EAST=552000
NORTH=7492000
# N50 county files covering the box (Kartverket names), for the no-go areas.
N50_COUNTIES="18_Nordland"
