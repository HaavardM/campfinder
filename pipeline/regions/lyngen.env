# The Lyngen Alps: the peninsula between Lyngenfjorden and Ullsfjorden,
# from Oteren and Skibotn north past Jiehkkevárri and Lyngseidet to its
# tip. Much of it is sea, which the N50 sea map lets the engine skip. A box
# around Kartverket's place names. EPSG:25833 metres, on the 2 km tile grid
# (684 tiles).
WEST=680000
SOUTH=7690000
EAST=716000
NORTH=7766000
# N50 county files covering the box (Kartverket names), for the no-go areas.
N50_COUNTIES="55_Troms"
