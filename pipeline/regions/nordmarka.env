# Nordmarka, Oslo's northern forest, from the city's edge up to Hakadal and
# Grua, with Krokskogen to the west. No official boundary, so a box around
# Kartverket's place name (254 km E, 6675 km N). EPSG:25833 metres, on the
# 2 km tile grid.
WEST=236000
SOUTH=6654000
EAST=268000
NORTH=6698000
# N50 county files covering the box (Kartverket names), for the no-go areas.
N50_COUNTIES="03_Oslo 32_Akershus 33_Buskerud"
