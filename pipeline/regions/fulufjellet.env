# Fulufjellet national park and the Trysil fells: the park's official
# extent (Miljødirektoratet's protected-area register), widened west to
# Trysilfjellet and Ljørdalen. On the Swedish border, where there's no
# surface data and no N50: no spots on that side. EPSG:25833 metres, on the
# 2 km tile grid (357 tiles).
WEST=344000
SOUTH=6796000
EAST=386000
NORTH=6830000
# N50 county files covering the box (Kartverket names), for the no-go areas.
N50_COUNTIES="34_Innlandet"
