# Hallingskarvet national park: its official extent (Miljødirektoratet's
# protected-area register), from Finse and the edge of Hardangerjøkulen to
# Ustaoset. Takes in what lies just north of Hardangervidda. Bounding box
# in EPSG:25833 metres, on the 2 km tile grid (273 tiles).
WEST=82000
SOUTH=6730000
EAST=124000
NORTH=6756000
# N50 county files covering the box (Kartverket names), for the no-go areas.
N50_COUNTIES="46_Vestland 33_Buskerud"
