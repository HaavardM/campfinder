# Lifjell, between Bø, Seljord and Notodden: a small, close mountain with
# lakes on top. A box around Kartverket's place name for the mountain area.
# EPSG:25833 metres, on the 2 km tile grid (121 tiles).
WEST=138000
SOUTH=6600000
EAST=160000
NORTH=6622000
# N50 county files covering the box (Kartverket names), for the no-go areas.
N50_COUNTIES="40_Telemark"
