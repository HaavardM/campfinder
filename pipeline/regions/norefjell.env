# Norefjell, above Krøderen. No official boundary, so a 20 km box centred
# on its highest point, Høgevarde (Kartverket's place name "Høgevard":
# 194 km E, 6697 km N). EPSG:25833 metres, on the 2 km tile grid.
WEST=184000
SOUTH=6688000
EAST=204000
NORTH=6708000
# N50 county files covering the box (Kartverket names), for the no-go areas.
N50_COUNTIES="33_Buskerud"
