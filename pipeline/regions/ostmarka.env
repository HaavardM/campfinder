# Østmarka, the forest between Oslo, Lørenskog, Rælingen and Enebakk. No
# official boundary, so a box around Kartverket's place name (275 km E,
# 6642 km N). EPSG:25833 metres, on the 2 km tile grid.
WEST=266000
SOUTH=6630000
EAST=282000
NORTH=6654000
# N50 county files covering the box (Kartverket names), for the no-go areas.
N50_COUNTIES="03_Oslo 32_Akershus"
