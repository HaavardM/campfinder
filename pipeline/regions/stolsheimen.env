# Stølsheimen, the high plateau between Voss, Modalen and Sognefjorden,
# west of the Vikafjellet box and south of the Sogn box. A box around
# Kartverket's place names, starting at the tile grid's western edge (0).
# EPSG:25833 metres, on the 2 km tile grid (280 tiles).
WEST=0
SOUTH=6760000
EAST=28000
NORTH=6800000
# N50 county files covering the box (Kartverket names), for the no-go areas.
N50_COUNTIES="46_Vestland"
