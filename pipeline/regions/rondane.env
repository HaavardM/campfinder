# Rondane national park: its official extent (Miljødirektoratet's
# protected-area register), which takes in Mysuseter, Høvringen and Straumbu.
# Bounding box in EPSG:25833 metres, on the 2 km tile grid.
WEST=204000
SOUTH=6848000
EAST=248000
NORTH=6896000
# N50 county files covering the box (Kartverket names), for the no-go areas.
N50_COUNTIES="34_Innlandet"
