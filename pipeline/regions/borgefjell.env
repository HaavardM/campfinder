# Børgefjell/Burkijen national park: its official extent (Miljødirektoratet's
# protected-area register), on the Nordland/Trøndelag border. Its eastern
# edge reaches into Sweden, where there's no surface data and no N50: no
# spots there. EPSG:25833 metres, on the 2 km tile grid (728 tiles).
WEST=422000
SOUTH=7198000
EAST=474000
NORTH=7254000
# N50 county files covering the box (Kartverket names), for the no-go areas.
N50_COUNTIES="18_Nordland 50_Trondelag"
