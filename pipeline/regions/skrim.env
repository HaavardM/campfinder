# Skrim, the hills and lakes south of Kongsberg. No official boundary, so a
# 20 km box around Kartverket's place name (194 km E, 6610 km N). EPSG:25833
# metres, on the 2 km tile grid (100 tiles).
WEST=184000
SOUTH=6600000
EAST=204000
NORTH=6620000
# N50 county files covering the box (Kartverket names), for the no-go areas.
N50_COUNTIES="33_Buskerud 40_Telemark 39_Vestfold"
