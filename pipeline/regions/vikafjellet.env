# Vikafjellet, the mountain pass on Rv13 between Voss and Vik, from
# Myrkdalen and Vinje over the top down to Vik, where the Balestrand box
# starts. No official boundary, so a box around Kartverket's place names.
# EPSG:25833 metres, on the 2 km tile grid (204 tiles).
WEST=28000
SOUTH=6766000
EAST=52000
NORTH=6800000
# N50 county files covering the box (Kartverket names), for the no-go areas.
N50_COUNTIES="46_Vestland"
