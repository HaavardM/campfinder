# Haukelifjell around Haukeliseter, south and west of Hardangervidda: from
# Røldal and Breifonn to Haukeliheii, and south of the Hardangervidda box,
# which takes in Haukeliseter itself. No official boundary, so a box around
# those places (Kartverket's place names). EPSG:25833 metres, on the 2 km
# tile grid (264 tiles).
WEST=40000
SOUTH=6636000
EAST=84000
NORTH=6660000
# N50 county files covering the box (Kartverket names), for the no-go areas.
N50_COUNTIES="40_Telemark 11_Rogaland 46_Vestland 42_Agder"
