# Blefjell, the ridge between Flesberg, Notodden and Tinn, above the
# treeline at Store Ble (1342 m). No official boundary, so a 20 km box
# around Kartverket's place name (175 km E, 6649 km N). EPSG:25833 metres,
# on the 2 km tile grid (100 tiles).
WEST=164000
SOUTH=6638000
EAST=184000
NORTH=6658000
# N50 county files covering the box (Kartverket names), for the no-go areas.
N50_COUNTIES="40_Telemark 33_Buskerud"
