# Femundsmarka national park: its official extent (Miljødirektoratet's
# protected-area register), on the Innlandet/Trøndelag border. Bounding box
# in EPSG:25833 metres, on the 2 km tile grid.
WEST=340000
SOUTH=6886000
EAST=360000
NORTH=6942000
# N50 county files covering the box (Kartverket names), for the no-go areas.
N50_COUNTIES="34_Innlandet 50_Trondelag"
