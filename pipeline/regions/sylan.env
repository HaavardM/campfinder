# Sylan and Skarvan og Roltdalen: Trøndelag's high fells on the Swedish
# border, from Stugudalen, Nedalshytta and Storsylen north past Fongen to
# Meråker. Open, gentle terrain. The Swedish side has no surface data and no
# N50: no spots there. A box around Kartverket's place names. EPSG:25833
# metres, on the 2 km tile grid (875 tiles).
WEST=312000
SOUTH=6970000
EAST=362000
NORTH=7040000
# N50 county files covering the box (Kartverket names), for the no-go areas.
N50_COUNTIES="50_Trondelag"
