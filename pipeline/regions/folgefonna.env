# The Folgefonna peninsula between Hardangerfjorden and Sørfjorden: the
# glacier and the mountains around it, from Rosendal to Jondal and Odda.
# Hardangervidda's box starts just east of Odda. A box around Kartverket's
# place names, starting at the tile grid's western edge (0). EPSG:25833
# metres, on the 2 km tile grid (425 tiles).
WEST=0
SOUTH=6668000
EAST=34000
NORTH=6718000
# N50 county files covering the box (Kartverket names), for the no-go areas.
N50_COUNTIES="46_Vestland"
