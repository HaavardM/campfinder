# Aurland: Aurlandsfjellet, the Snow Road from Aurlandsvangen over
# Vedahaugane to Erdal in Lærdal, and Aurlandsdalen down to Vassbygdi. Its
# upper end, from Finse, is in the Hallingskarvet box just south. No
# official boundary, so a box around Kartverket's place names. EPSG:25833
# metres, on the 2 km tile grid (352 tiles).
WEST=72000
SOUTH=6756000
EAST=104000
NORTH=6800000
# N50 county files covering the box (Kartverket names), for the no-go areas.
N50_COUNTIES="46_Vestland 33_Buskerud"
