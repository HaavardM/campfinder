# Hardangervidda national park: its official extent (Miljødirektoratet's
# protected-area register), from Hårteigen to Haukeli and Tinn. Finse and
# Hardangerjøkulen lie just north of it, outside the box. Bounding box in
# EPSG:25833 metres, on the 2 km tile grid (1551 tiles, three times
# Rondane).
WEST=38000
SOUTH=6656000
EAST=132000
NORTH=6722000
# N50 county files covering the box (Kartverket names), for the no-go areas.
N50_COUNTIES="46_Vestland 40_Telemark 33_Buskerud"
