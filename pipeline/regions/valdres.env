# Valdres's mountains: Filefjell and Grindaheim in the west to Skaget in the
# east, Vaset in the south up to where the Jotunheimen box starts, with
# Bitihorn, Mugnetinden and Beitostølen. No official boundary, so a box
# around those places (Kartverket's place names). Its eastern edge overlaps
# Langsua. EPSG:25833 metres, on the 2 km tile grid (494 tiles).
WEST=142000
SOUTH=6770000
EAST=180000
NORTH=6822000
# N50 county files covering the box (Kartverket names), for the no-go areas.
N50_COUNTIES="34_Innlandet 33_Buskerud"
