# Reinheimen national park: its official extent (Miljødirektoratet's
# protected-area register), between Lesja, Lom and Romsdalen. The park is
# long and irregular, so its box is big; it overlaps Dovre and Valldal,
# whose tiles aren't computed twice. EPSG:25833 metres, on the 2 km tile
# grid (1440 tiles).
WEST=106000
SOUTH=6882000
EAST=186000
NORTH=6954000
# N50 county files covering the box (Kartverket names), for the no-go areas.
N50_COUNTIES="34_Innlandet 15_More_og_Romsdal"
