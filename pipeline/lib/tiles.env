# The work-tile grid, shared by the download scripts. Must match TILE_SIZE_M
# and BUFFER_M in flatness/src/tile.rs (tiles are size-checked there, so a
# mismatch fails loudly).
TILE_M=2000 # tiles are 2 × 2 km, aligned to multiples of 2000 m in EPSG:25833
BUFFER_M=8  # extra border downloaded around each tile
