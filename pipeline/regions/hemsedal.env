# Hemsedal and Hemsedalsfjellet, along Rv52 from the valley and Skogshorn
# over the mountain to Borlaug. No official boundary, so a box around
# Kartverket's place names; its eastern part overlaps Valdres. (Sognefjellet,
# on Rv55, is in the Jotunheimen box.) EPSG:25833 metres, on the 2 km tile
# grid (576 tiles).
WEST=118000
SOUTH=6748000
EAST=166000
NORTH=6796000
# N50 county files covering the box (Kartverket names), for the no-go areas.
N50_COUNTIES="33_Buskerud 46_Vestland 34_Innlandet"
