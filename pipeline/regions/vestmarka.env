# Vestmarka, the forest west of Oslo between Bærum, Asker and Lier. No
# official boundary, so a 20 km box around Kartverket's place name (241 km
# E, 6647 km N). EPSG:25833 metres, on the 2 km tile grid (100 tiles).
WEST=232000
SOUTH=6636000
EAST=252000
NORTH=6656000
# N50 county files covering the box (Kartverket names), for the no-go areas.
# (Oslo too: its western edge is close.)
N50_COUNTIES="32_Akershus 33_Buskerud 03_Oslo"
