# Finnemarka, the forest above Drammen between Lier, Modum and Øvre Eiker.
# No official boundary, so a 20 km box around Kartverket's place name
# (223 km E, 6649 km N). EPSG:25833 metres, on the 2 km tile grid
# (100 tiles).
WEST=214000
SOUTH=6640000
EAST=234000
NORTH=6660000
# N50 county files covering the box (Kartverket names), for the no-go areas.
N50_COUNTIES="33_Buskerud"
