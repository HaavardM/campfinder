# Jotunheimen national park: its official extent (Miljødirektoratet's
# protected-area register), with Gjende, Bygdin, Leirdalen and Valdresflye.
# Bounding box in EPSG:25833 metres, on the 2 km tile grid (640 tiles).
WEST=112000
SOUTH=6822000
EAST=176000
NORTH=6862000
# N50 county files covering the box (Kartverket names), for the no-go areas.
N50_COUNTIES="34_Innlandet 46_Vestland"
